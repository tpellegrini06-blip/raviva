# Copier en .env (jamais versionné) pour un usage local.
# En automatique, ces valeurs vivent dans les secrets du dépôt, pas dans un fichier.

ED_IDENTIFIANT=
ED_MOT_DE_PASSE=

# Obtenus une fois avec `python bootstrap_2fa.py`
ED_FA_CN=
ED_FA_CV=

ED_FUSEAU=Europe/Paris

# Envoi du brief par mail (facultatif)
ED_SMTP_HOTE=smtp.gmail.com
ED_SMTP_PORT=587
ED_SMTP_UTILISATEUR=
ED_SMTP_MOT_DE_PASSE=
ED_MAIL_DESTINATAIRE=
